#!/bin/sh -eu

# Fetch a firmware release from GitHub, verify it, and stage it for the next
# boot. The board can reach the internet and carries a CA bundle, so this
# removes the workstation from the update path entirely.
#
# This is only safe because /etc/init.d/S99postupdate now gates promotion on a
# health check: an image that boots but cannot serve, or that loses the switch
# and islands the compute nodes, is rejected and the board reboots back onto
# the image it came from. Without that gate, pulling firmware unattended over
# the internet would be a way to brick the board from the comfort of a script.
#
# Deliberately does NOT reboot unless asked. Staging is reversible right up to
# the reboot -- `fw_setenv nextboot` alone puts everything back.

REPO="excavador/tp2-bmc-firmware"
# An HTTP directory to scan instead of a GitHub repository. Set with --url.
SOURCE_URL=""
CHANNEL="stable"
TAG=""
CHECK_ONLY=0
JSON=0
LIST_ONLY=0
ALLOW_DOWNGRADE=0
DO_REBOOT=0
KEEP_IMAGE=0

# The rootfs UBI volume osupdate writes into: 370 LEBs of 126976 bytes. An
# image larger than this fails halfway through ubiupdatevol, after the old
# volume has already been removed, which is the one moment in the whole update
# where there is nothing to fall back to. Checked here so the download is
# thrown away instead.
SLOT_BYTES=46981120

# Same preference order as bmcd's staging: the SD card costs no NAND wear and
# has room to spare, the overlay is what a card-less board has, and the tmpfs
# is a 58MB RAM disk on a board with 116MB of RAM and only a last resort.
STAGING_DIRS="/mnt/sdcard /mnt/overlay /tmp"

usage() {
	cat <<EOF
Usage: tpi-selfupdate [options]

  --channel stable|edge  which release to follow (default: stable)
                         stable = the release GitHub marks "Latest", which
                                  excludes pre-releases
                         edge   = the most recently published release,
                                  pre-releases included
  --tag TAG              install this exact tag, ignoring --channel
  --repo OWNER/REPO      release repository (default: $REPO)
  --url PREFIX           scan an HTTP directory instead of a GitHub repo.
                         Expects <PREFIX>/<version>/<image>.tpu, which is what
                         firmware.turingpi.com serves. Checksums are used when
                         the directory publishes them and ABSENT otherwise --
                         upstream's does not, so an image from there is
                         trusted on TLS alone.
  --check                report what would happen and exit; downloads nothing
  --list                 print every release this repository offers, newest
                         first, and exit. Implies --json. Enumerates rather
                         than resolving: --check answers "what would I
                         install", --list answers "what is there". bmcd uses
                         it to let an operator pick a version, including an
                         older one.
  --json                 print one JSON object on STDOUT describing what the
                         channel resolves to. Every log line already goes to
                         stderr, so stdout carries the object and nothing
                         else. Meant for bmcd, which reports it to the web
                         interface rather than reimplementing release
                         resolution in the daemon.
  --allow-downgrade      install a tag that is not newer than the running one
  --reboot               reboot once the image is staged
  --keep                 keep the downloaded image instead of deleting it
  -h, --help             this text

Exit status is 0 when an update was staged, 1 on error, and 2 when the board
is already up to date.
EOF
}

log() { echo "tpi-selfupdate: $*" >&2; }
die() { log "$*"; exit 1; }

while [ $# -gt 0 ]; do
	case "$1" in
		--channel) CHANNEL="${2:-}"; shift 2 ;;
		--tag) TAG="${2:-}"; shift 2 ;;
		--repo) REPO="${2:-}"; shift 2 ;;
		--url) SOURCE_URL="${2:-}"; shift 2 ;;
		--check) CHECK_ONLY=1; shift ;;
		--json) JSON=1; shift ;;
		--list) LIST_ONLY=1; JSON=1; shift ;;
		--allow-downgrade) ALLOW_DOWNGRADE=1; shift ;;
		--reboot) DO_REBOOT=1; shift ;;
		--keep) KEEP_IMAGE=1; shift ;;
		-h|--help) usage; exit 0 ;;
		*) usage >&2; die "unknown argument: $1" ;;
	esac
done

case "$CHANNEL" in
	stable|edge) ;;
	*) die "--channel must be stable or edge, not '$CHANNEL'" ;;
esac

#
# running_version
#
# The tag this board is running, from the VERSION key post_build.sh writes.
#
running_version() {
	sed -n 's/^VERSION=//p' /etc/os-release | tr -d '"' | head -1
}

#
# update_pending
#
# Where the staged version is recorded for bmcd to read. S99postupdate removes
# it once the image it describes has been promoted or rejected.
STAGED_NOTE=/mnt/overlay/staged-firmware

# True when an update is already staged for the next boot. Staging a second one
# on top would remove the rootfs_new volume the first one wrote and leave
# nextboot pointing at a volume that is being rebuilt.
#
update_pending() {
	[ -n "$(fw_printenv -n nextboot 2>/dev/null || true)" ]
}

#
# resolve_tag
#
# Ask GitHub which release to install. Only the tag is taken from the API; the
# download URLs are constructed, so a change in the API's asset shape cannot
# send this script somewhere unexpected.
#
# The distinction matters here more than it usually would: every release in
# this repository so far is a pre-release, so GitHub's "Latest" is an OLD tag
# and following it blindly would walk the board backwards.
#
resolve_tag() {
	if [ "$CHANNEL" = "stable" ]; then
		api="https://api.github.com/repos/$REPO/releases/latest"
	else
		# NOT ?per_page=1. GitHub orders /releases by created_at, which is
		# when the TAG was made, not when the release was published. A tag
		# pushed first but built slower therefore sorts ahead of one already
		# on the board: during the hive.10 flash this endpoint returned
		# hive.9 as "newest" while hive.10 was being installed, because
		# hive.10's release did not exist yet when its own tag did. Take a
		# page and pick the highest version, which is what "newest" means
		# here and is the same ordering the downgrade guard already uses.
		api="https://api.github.com/repos/$REPO/releases?per_page=30"
	fi

	body=$(curl -sSfL --max-time 30 "$api") \
		|| die "cannot reach the GitHub API at $api"

	if [ "$CHANNEL" = "stable" ]; then
		tag=$(printf '%s' "$body" \
			| sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
			| head -1)
	else
		tag=$(printf '%s' "$body" \
			| tr ',' '\n' \
			| sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
			| sort -V | tail -1)
	fi

	[ -n "$tag" ] || die "no release found on the $CHANNEL channel of $REPO"
	printf '%s' "$tag"
}

#
# is_newer CANDIDATE RUNNING
#
# True when CANDIDATE sorts after RUNNING. `sort -V` is not semantic version
# comparison, but it orders this repository's tags correctly, including
# hive.10 after hive.9, which a plain lexical sort does not.
#
is_newer() {
	[ "$1" != "$2" ] || return 1
	newest=$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)
	[ "$newest" = "$1" ]
}

#
# is_versioned STRING
#
# Whether a string is version-shaped at all: optional `v`, then digits and
# dots, then anything (so v2.2.0-unstable-hive.12 counts).
#
# This exists because `sort -V` will happily order ANY two strings, including
# ones that carry no version. A board built by `just build` reports
# VERSION=local, and sorting `local` against real tags puts it first -- so
# every release, including genuinely older code, came out marked "newer".
# Measured on the board 2026-09-08: running `local`, v2.3.0 was offered as an
# upgrade. An unversioned build must report an UNKNOWN relation rather than a
# wrong one; the caller can then say so instead of implying an order.
#
is_versioned() {
	case "$1" in
		v[0-9]*|[0-9]*) return 0 ;;
		*) return 1 ;;
	esac
}

#
# staging_dir BYTES
#
# The first of $STAGING_DIRS that is a mount of its own and has room. The mount
# test matters: /mnt/sdcard exists as an empty directory when no card is in the
# slot, and writing there would silently fill the root filesystem instead.
#
staging_dir() {
	need=$1
	for dir in $STAGING_DIRS; do
		awk -v p="$dir" '$2 == p { f = 1 } END { exit !f }' /proc/mounts \
			|| continue
		free=$(df -kP "$dir" 2>/dev/null | awk 'NR == 2 { print $4 * 1024 }')
		[ -n "$free" ] || continue
		[ "$free" -ge "$need" ] || continue
		printf '%s' "$dir"
		return 0
	done
	return 1
}

#
# relation_to CANDIDATE RUNNING
#
# One of: current, newer, older, unknown. `unknown` when either side is not
# version-shaped -- which is the honest answer for a locally built image, and
# the reason this is not just `is_newer`.
#
relation_to() {
	if [ "$1" = "$2" ]; then
		printf 'current'
	elif ! is_versioned "$1" || ! is_versioned "$2"; then
		printf 'unknown'
	elif is_newer "$1" "$2"; then
		printf 'newer'
	else
		printf 'older'
	fi
}

#
# http_versions
#
# Version directories under an HTTP prefix, newest first.
#
# This parses Apache mod_autoindex output, which is PRESENTATION and not an
# API: a server upgrade or a theme change can break it without warning. So a
# caller must treat "no versions found" as "this source returned nothing
# usable" and never as "there are no updates" -- the two are indistinguishable
# from here, and only the caller knows which claim it is about to make.
#
# Verified against https://firmware.turingpi.com/turing-pi2/ on 2026-09-08:
# per-version directories v2.0.5/ .. v1.0.1/, each holding tp2-ota-<v>.tpu.
#
http_versions() {
	body=$(curl -sSfL --max-time 30 "$SOURCE_URL/") \
		|| die "cannot reach $SOURCE_URL"

	printf '%s' "$body" \
		| tr '<' '\n' \
		| sed -n 's/.*href="\(v\{0,1\}[0-9][^"\/]*\)\/".*/\1/p' \
		| sort -u \
		| sort -V -r
}

#
# http_asset TAG
#
# The .tpu in one version directory, and its checksum when the directory
# publishes one. Two lines: URL, then the sha256 or an empty line.
#
# Deliberately NOT called while listing: listing costs one request, and
# resolving every version's asset would cost one per version for information
# nobody has asked for yet.
#
http_asset() {
	tag=$1
	dir="$SOURCE_URL/$tag"
	body=$(curl -sSfL --max-time 30 "$dir/") \
		|| die "cannot list $dir"

	# Any .tpu in the directory. The filename convention differs between
	# publishers -- upstream ships tp2-ota-<v>.tpu, this fork ships
	# tp2-bmc-firmware-ota-<v>.tpu -- so match the extension, not a prefix.
	asset=$(printf '%s' "$body" \
		| tr '<' '\n' \
		| sed -n 's/.*href="\([^"]*\.tpu\)".*/\1/p' \
		| head -1)
	[ -n "$asset" ] || die "no .tpu in $dir"

	printf '%s/%s\n' "$dir" "$asset"

	# Checksums, if this publisher ships any. Upstream does not: SHA256SUMS,
	# sha256sum.txt, sha256 and checksums.txt all 404 on
	# firmware.turingpi.com as of 2026-09-08. An absent checksum is reported
	# as empty rather than as a failure, because it is the normal state for
	# that source -- but the caller must then say so rather than implying the
	# image was verified.
	for name in SHA256SUMS sha256sum.txt sha256 checksums.txt; do
		sums=$(curl -sfL --max-time 20 "$dir/$name" 2>/dev/null) || continue
		sum=$(printf '%s' "$sums" | awk -v f="$(basename "$asset")" '$2 == f || $2 == "*" f { print $1; exit }')
		[ -n "$sum" ] || continue
		printf '%s\n' "$sum"
		return 0
	done
	printf '\n'
}

#
# list_releases
#
# Every release the repository offers, newest first, as a JSON array.
#
# GitHub returns one object per release; splitting on the `},{` boundary gives
# one chunk each, which is enough to read a tag and its flags without a JSON
# parser -- and there is none on this board, no jq and no python3, only awk
# and sed.
#
# Drafts are skipped: they are not installable by anyone but their author.
# Pre-releases are KEPT and flagged, because "show me older or unstable
# builds" is exactly what a human picking from a list may want; the flag lets
# the caller decide rather than deciding for it here.
#
list_releases() {
	api="https://api.github.com/repos/$REPO/releases?per_page=100"
	body=$(curl -sSfL --max-time 30 "$api") \
		|| die "cannot reach the GitHub API at $api"

	printf '%s' "$body" \
		| sed 's/},[[:space:]]*{/}\n{/g' \
		| while IFS= read -r chunk; do
			tag=$(printf '%s' "$chunk" \
				| sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
				| head -1)
			[ -n "$tag" ] || continue
			draft=$(printf '%s' "$chunk" \
				| sed -n 's/.*"draft"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p' \
				| head -1)
			[ "$draft" = "true" ] && continue
			pre=$(printf '%s' "$chunk" \
				| sed -n 's/.*"prerelease"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p' \
				| head -1)
			[ -n "$pre" ] || pre=false
			printf '%s\t%s\n' "$tag" "$pre"
		done \
		| sort -V -r -k1,1
}

running=$(running_version)
[ -n "$running" ] || die "cannot read VERSION from /etc/os-release"

if [ "$LIST_ONLY" -eq 1 ] && [ -n "$SOURCE_URL" ]; then
	printf '{"url":"%s","running":"%s","releases":[' "$SOURCE_URL" "$running"
	first=1
	http_versions | while IFS= read -r tag; do
		[ -n "$tag" ] || continue
		relation=$(relation_to "$tag" "$running")
		case "$relation" in
			newer) newer=true; current=false ;;
			current) newer=false; current=true ;;
			*) newer=false; current=false ;;
		esac
		[ "$first" -eq 1 ] || printf ','
		first=0
		# prerelease has no meaning for a directory listing; false, not absent,
		# so the shape matches the GitHub form and one consumer reads both.
		printf '{"tag":"%s","prerelease":false,"newer":%s,"current":%s,"relation":"%s"}' \
			"$tag" "$newer" "$current" "$relation"
	done
	printf ']}\n'
	exit 0
fi

if [ "$LIST_ONLY" -eq 1 ]; then
	printf '{"repo":"%s","running":"%s","releases":[' "$REPO" "$running"
	first=1
	list_releases | while IFS="$(printf '\t')" read -r tag pre; do
		[ -n "$tag" ] || continue
		relation=$(relation_to "$tag" "$running")
		case "$relation" in
			newer) newer=true; current=false ;;
			current) newer=false; current=true ;;
			*) newer=false; current=false ;;
		esac
		[ "$first" -eq 1 ] || printf ','
		first=0
		printf '{"tag":"%s","prerelease":%s,"newer":%s,"current":%s,"relation":"%s"}' \
			"$tag" "$pre" "$newer" "$current" "$relation"
	done
	printf ']}\n'
	exit 0
fi

if [ -n "$TAG" ]; then
	target="$TAG"
	log "target $target (given explicitly)"
else
	target=$(resolve_tag)
	log "target $target (newest on the $CHANNEL channel of $REPO)"
fi

log "running $running"

# --json reports the resolution and stops there when asked only to check.
# It is emitted HERE, after both ends of the comparison are known and
# before any of the download work, so a caller asking "is there an update"
# never pays for one. The values are release tags and an owner/repo, so
# they need no JSON escaping -- and `resolve_target` has already refused
# anything that does not look like a tag.
if [ "$JSON" -eq 1 ]; then
	if [ "$target" = "$running" ]; then
		available=false
	elif is_newer "$target" "$running"; then
		available=true
	else
		available=false
	fi
	printf '{"channel":"%s","repo":"%s","running":"%s","target":"%s","update_available":%s}\n' \
		"$CHANNEL" "$REPO" "$running" "$target" "$available"
	# Exit 0 rather than 2: the JSON says whether an update exists, so the
	# exit status does not have to, and a caller parsing stdout should not
	# also have to special-case a non-zero status for "no news".
	[ "$CHECK_ONLY" -eq 1 ] && exit 0
fi

if [ "$target" = "$running" ]; then
	log "already running $target"
	[ "$ALLOW_DOWNGRADE" -eq 1 ] || exit 2
	log "reinstalling it anyway, because --allow-downgrade was given"
elif ! is_newer "$target" "$running"; then
	if [ "$ALLOW_DOWNGRADE" -eq 1 ]; then
		log "installing an older release, because --allow-downgrade was given"
	elif [ "$CHECK_ONLY" -eq 1 ]; then
		# --check reports; it does not fail just because there is nothing to do.
		log "$target is not newer than $running; nothing to do"
		exit 2
	else
		die "$target is not newer than $running; pass --allow-downgrade to install it anyway"
	fi
fi

base="https://github.com/$REPO/releases/download/$target"
image="tp2-bmc-firmware-ota-$target.tpu"

# The per-file .sha256 assets record the absolute path they were generated
# from on the build machine, so `sha256sum -c` on one of them fails to open a
# file rather than reporting a mismatch. SHA256SUMS lists bare basenames.
sums=$(curl -sSfL --max-time 30 "$base/SHA256SUMS") \
	|| die "cannot fetch SHA256SUMS for $target"
expected=$(printf '%s\n' "$sums" | awk -v f="$image" '$2 == f { print $1 }' | head -1)
[ -n "$expected" ] || die "SHA256SUMS for $target does not list $image"

if [ "$CHECK_ONLY" -eq 1 ]; then
	log "would install $image"
	log "  from     $base/$image"
	log "  sha256   $expected"
	log "nothing downloaded or changed"
	exit 0
fi

if update_pending; then
	die "an update is already staged for the next boot; reboot first, or clear it with 'fw_setenv nextboot'"
fi

dir=$(staging_dir "$SLOT_BYTES") \
	|| die "no writable mount among $STAGING_DIRS has room for the image"
log "staging in $dir"
path="$dir/$image"

curl -sSfL --max-time 900 --retry 3 -o "$path" "$base/$image" \
	|| die "download failed: $base/$image"

actual=$(sha256sum "$path" | cut -d' ' -f1)
if [ "$actual" != "$expected" ]; then
	rm -f "$path"
	die "checksum mismatch for $image; downloaded copy deleted"
fi
log "checksum verified: $expected"

size=$(wc -c < "$path")
if [ "$size" -gt "$SLOT_BYTES" ]; then
	rm -f "$path"
	die "image is $size bytes and the rootfs volume holds $SLOT_BYTES; refusing to start an update that cannot finish"
fi
log "image is $size bytes, $((size * 100 / SLOT_BYTES))% of the rootfs volume"

log "writing the image; do not cut power until this returns"
/sbin/osupdate "$path"

[ "$KEEP_IMAGE" -eq 1 ] || rm -f "$path"

# Record WHICH image is staged, for bmcd to report and the web interface to
# show. The staging volume is static and never mounted, so nothing can read a
# version out of it from a running system -- the same reason the rollback slot
# has none. So the stager, which knows the tag, leaves it here.
#
# The overlay, because both images mount it: the note has to survive the
# reboot it describes. postupdate.log is next to it for the same reason, and
# S99postupdate removes this file once it has decided.
#
# Written AFTER osupdate returns. `set -eu` at the top means a failed write
# ends the script, so a note can never claim an image that was not staged --
# but a board with no overlay mounted should still be able to update, which
# is why the directory is checked rather than assumed.
if [ -d "$(dirname "$STAGED_NOTE")" ]; then
	{
		printf 'VERSION=%s\n' "$target"
		printf 'SHA256=%s\n' "$expected"
		printf 'STAGED_AT=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
		printf 'SIZE_BYTES=%s\n' "$size"
		printf 'SOURCE=tpi-selfupdate\n'
	} > "$STAGED_NOTE" || log "warning: could not record the staged version in $STAGED_NOTE"
fi

log "staged $target for the next boot"
log "the next boot is tentative: if bmcd does not answer or the switch does not"
log "come up, S99postupdate rejects it and reboots back onto $running"

if [ "$DO_REBOOT" -eq 1 ]; then
	log "rebooting"
	sync
	reboot
else
	log "reboot when ready, or run 'fw_setenv nextboot' to cancel"
fi
