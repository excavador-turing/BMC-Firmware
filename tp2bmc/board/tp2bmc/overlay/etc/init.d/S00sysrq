#!/bin/sh
#
# Keep the full magic SysRq command set available on the BMC console.
#
# This board has no watchdog, so when its userspace wedges the only remedy is
# a person walking to the rack and cutting power. A serial reset is the one
# remote alternative, and it is worth keeping.
#
# What made that dangerous was not SysRq itself but its trigger: a BREAK on
# console=ttyS0, which USB-serial adapters assert whenever a port is opened,
# closed or reconfigured. A stray byte after one of those could reboot the
# board or SIGKILL everything on it. That is guarded in the kernel config now
# with MAGIC_SYSRQ_SERIAL_SEQUENCE, so BREAK alone does nothing and the
# sequence has to follow it.
#
# This script only makes the runtime value explicit and greppable, so nobody
# reading the init scripts has to infer it from a kernel config:
#
#   BREAK, then "sysrq", then the command key.
#     b  reboot          o  power off        w  show blocked tasks
#     m  memory report   t  all tasks        s  sync
SYSRQ_MASK=1

case "$1" in
	start|"")
		printf 'Magic SysRq (guarded by a serial sequence): '
		if printf '%s\n' "${SYSRQ_MASK}" > /proc/sys/kernel/sysrq 2>/dev/null; then
			echo "OK"
		else
			echo "FAIL"
			exit 1
		fi
		;;
	stop)
		;;
	restart|reload)
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
