#!/bin/sh
#
# Restrict magic SysRq, which the serial console can trigger by accident.
#
# The kernel is built with CONFIG_MAGIC_SYSRQ=y and boots with console=ttyS0,
# so a BREAK on that line is a SysRq trigger and the next byte is the command.
# USB-serial adapters assert BREAK as a matter of course when a port is opened,
# closed, or has its line settings changed -- so simply attaching a console can
# reboot the board, power it off, or SIGKILL every process on it.
#
# That is what a recovery console must never do. On 2026-09-09 a board was lost
# within two minutes of an FTDI adapter being wired to the BMC UART, while it
# was otherwise healthy.
#
# The mask keeps what is worth having on a board you are debugging and removes
# everything that can end its life:
#
#     2  console log level        kept
#     8  debugging dumps          kept -- `w` blocked tasks, `m` memory, `t` tasks
#    16  sync                     kept
#    32  remount read-only        DROPPED
#    64  signalling of processes  DROPPED -- term, kill, oom-kill
#   128  reboot / poweroff        DROPPED
#   256  nice all RT tasks        DROPPED
#
# 2 + 8 + 16 = 26. Reading a hung board stays possible; killing it does not.
SYSRQ_MASK=26

case "$1" in
	start|"")
		printf 'Restricting magic SysRq to %s: ' "${SYSRQ_MASK}"
		if printf '%s\n' "${SYSRQ_MASK}" > /proc/sys/kernel/sysrq 2>/dev/null; then
			echo "OK"
		else
			echo "FAIL"
			exit 1
		fi
		;;
	stop)
		;;
	restart|reload)
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
