#!/bin/sh -e

# This script implements the post-reboot half of the OTA update procedure. For
# the pre-reboot half, see `/sbin/osupdate`
#
# This script runs late in the boot process and looks for "postupdate" in the
# kernel args, indicating this boot is a "tentative" boot on the new image.
# If found, it makes the new boot permanent:
# 1) Rename the currently-mounted UBI root volume to "rootfs"
# 2) If the latter already exists, rename it to "rootfs_prev" first
# 3) If THAT already exists, remove it
#
# CHANGED IN THIS FORK: upstream promotes unconditionally. Reaching this script
# only proves that the kernel booted and that init got this far -- it says
# nothing about whether the machine is usable. Two images we built would have
# passed that bar while being broken: one where bmcd could not link and the web
# interface never came up, and one where the DSA switch driver silently dropped
# out of the kernel config, which leaves the BMC perfectly reachable and all
# four compute nodes cut off from the network. Once promoted, recovering from
# either needs physical access to the board.
#
# So promotion is now gated on health_ok(). If the check fails we simply reboot.
# That is all a rollback takes: u-boot boots the volume named "rootfs", which is
# still the previous image because we have not renamed anything yet, and the
# "nextboot" variable that steered this boot is one-shot and has already been
# consumed by u-boot. The next boot therefore has no "postupdate" in its command
# line and this script does nothing, so there is no reboot loop.
#
# The 6.18 kernel moved the switch onto the same two pins as the EEPROM and the
# RTC (PE12/PE13), serialised by an arbiter. A switch that probes while that
# arbiter or the I2C side is broken would pass the checks above, so the gate
# also asks for the two uplink ports, a readable EEPROM and a bound RTC.
# Interfaces are checked for existence, never for carrier: a board with no
# cable in ge0 or ge1 is a good board.
#
# And the network has to work. Every check above is local: a switch driver that
# registers its ports and then carries no frame passes all of them, the image
# is made permanent, and the board is unreachable. So the stager
# (/sbin/stage-gateway-note, run by osupdate) records the default gateway and
# whether it answered a ping while the OLD image was still running, and this
# boot must reach it again. Only a gateway that answered before is demanded: a
# board with no gateway, or one that never answered, is not blocked.
#
# A false rollback costs one extra BMC reboot. That does not power-cycle the
# compute nodes, so the cost of being wrong is small and the direction is safe.
#
# MISSING NOTES ARE A REJECTION. The stagers write every note this gate reads
# -- and sync it -- before they arm nextboot (/sbin/osupdate, step 6), so a
# tentative boot with no staged note can only be an interrupted staging or a
# note removed behind its back, and an image nothing vouches for is not made
# permanent. This used to be the other way round: "no staged note; version
# check skipped", and the same for the gateway note, which let an update that
# was cut or rebooted in the window between "nextboot armed" and "notes
# written" promote an image whose network was dead (BMC-Firmware#126). Two
# leniencies remain, each for a stager this gate cannot ask to change: a board
# with no overlay mounted cannot hold a note at all, and a staged note from
# before this change does not carry GATE_NOTES=1, so a missing gateway note
# is still read as "that stager recorded nothing".
#
# THE OTHER HALF, a normal boot. U-Boot deletes nextboot before it boots the
# staged volume. When power is lost during that tentative boot, before this
# script decides, the next boot is an ordinary one on the old image with
# nextboot unset -- and the notes of an update that will never boot are still
# on the overlay, where the firmware page shows a staged version for ever
# (BMC-Firmware#131). So on a boot that is not tentative, with nextboot unset,
# the notes are discarded and the decision is logged. A stager that is writing
# at that moment holds the staging lock, and its notes are left alone.

UBIDEV=/dev/ubi0
ROOTFS_PRIMARY=rootfs
ROOTFS_SECONDARY=rootfs_prev

# Where to record what happened. /var/log is a symlink into a tmpfs on this
# board, so a note written there would be gone by the time anyone could read
# it. /mnt/overlay is the UBI volume that BOTH the old and the new image mount,
# so a note written here survives the rollback reboot -- which is the only time
# anyone will want to read it.
LOGFILE=/mnt/overlay/postupdate.log
# What tpi-selfupdate (or the daemon's upgrade worker) wrote to say WHICH
# image it staged. bmcd reports it so the web interface can name the pending
# version. It describes an image whose fate is decided here, so this script
# owns removing it: left behind, it would keep naming a version that is
# already running, or one that was rejected.
STAGED_NOTE=/mnt/overlay/staged-firmware

# What the stager recorded about the network: GATEWAY=<ip> and
# GATEWAY_PING=ok|none, written by /sbin/stage-gateway-note while the old image
# still ran. A file of its own, because bmcd writes STAGED_NOTE itself, and
# replaces it whole, on the upload path. Removed with the staged note.
GATEWAY_NOTE=/mnt/overlay/staged-gateway

# The staging lock every stager holds (see /sbin/osupdate). Held by a stager
# that is mid-write, which has notes on disk and has not armed nextboot yet.
STAGE_LOCK=/run/firmware-stage.lock

# What the rollback volume holds, written here at promotion because this is
# the only moment anything knows: the volume itself is never mounted.
ROLLBACK_VERSION=/mnt/overlay/rollback-version

# What the running image says it is, and where /metrics is served.
# Variables rather than literals so the gate can be exercised against a
# stubbed copy on the board's own shell, without a flash.
OS_RELEASE=/etc/os-release
METRICS_URL=http://127.0.0.1:9110/metrics
# The curl the gate uses, for the same reason: tests/gate.sh points this at a
# stub, so the `-x` check and the argument handling are exercised rather than
# bypassed.
CURL_BIN=/usr/bin/curl

# How long to give bmcd to answer. It is started by S94bmcd, five scripts
# earlier, and on a first boot it may still be generating a self-signed
# certificate before it binds.
HEALTH_TIMEOUT=120
HEALTH_INTERVAL=3

# How long to wait for the recorded gateway to answer. The link, DHCP and the
# switch may all still be coming up when the gate gets here, so it retries;
# each attempt is itself a `ping -c 2 -W 2`.
GATEWAY_TIMEOUT=60
GATEWAY_INTERVAL=3
PING_BIN=ping

# The tool that reads the U-Boot environment, and the kernel command line,
# where a tentative boot says "postupdate". Variables, like the paths above,
# so tests/gate.sh can stub them.
FW_PRINTENV_BIN=fw_printenv
PROC_CMDLINE=/proc/cmdline

# The network interfaces the DSA switch driver creates, one per compute node.
# If the driver fails to probe, these do not appear at all.
SWITCH_PORTS="node1 node2 node3 node4"

# The two uplink ports of the same switch. Existence is required, carrier is
# not: an uplink with no cable is down, and that is normal.
UPLINK_PORTS="ge0 ge1"

# Where the kernel lists network interfaces and I2C devices. Variables rather
# than literals so tests/gate.sh can point them at a scratch directory.
SYS_NET=/sys/class/net
SYS_I2C=/sys/bus/i2c/devices

#
# log MESSAGE
#
# To the boot console, and to a file that survives a rollback.
#
log() {
	info="postupdate: $*"
	echo "$info"
	{ echo "$(date 2>/dev/null) $info" >>"$LOGFILE"; } 2>/dev/null || true
}

#
# bmcd_answers
#
# True when the management daemon is serving. Any HTTP status counts: a
# rejected request still proves the daemon is up and handling connections.
# Falls back to reading the listening socket out of /proc if curl is ever
# dropped from the image, so that trimming the rootfs cannot turn this gate
# into a machine that rolls back every good update. 01BB is port 443 and 0A
# is TCP_LISTEN.
#
bmcd_answers() {
	if [ -x /usr/bin/curl ]; then
		curl -sk -o /dev/null --max-time 5 https://127.0.0.1/ 2>/dev/null
		return $?
	fi

	awk '$2 ~ /:01BB$/ && $4 == "0A" { f = 1 } END { exit !f }' \
		/proc/net/tcp /proc/net/tcp6 2>/dev/null
}

#
# switch_ports_present
#
# True when every compute node's switch port exists. Deliberately does not
# look at operstate: a port is legitimately down when its node is powered off,
# but it is missing only when the switch driver did not probe.
#
switch_ports_present() {
	for port in $SWITCH_PORTS; do
		if [ ! -d "$SYS_NET/$port" ]; then
			log "FAILED: switch port $port does not exist"
			return 1
		fi
	done

	return 0
}

#
# uplinks_present
#
# True when ge0 and ge1 exist. The same reasoning as above and the same limit:
# the interface is there when the switch driver registered the port, whether or
# not a cable is plugged in, so this never looks at operstate or carrier.
#
uplinks_present() {
	for port in $UPLINK_PORTS; do
		if [ ! -d "$SYS_NET/$port" ]; then
			log "FAILED: uplink port $port does not exist"
			return 1
		fi
	done

	return 0
}

#
# eeprom_readable
#
# True when the board EEPROM answers a read. The EEPROM holds the board
# identity and MAC that bmcd and `tpi about` read, and it sits on the I2C
# controller whose pins the switch now shares, so a broken hand-over between
# the two shows up here. The at24 driver exposes it as
# <bus>-0050/eeprom; sixteen bytes are enough to prove the bus works, and the
# content is deliberately not judged (a blank EEPROM reads as 0xFF and is a
# provisioning matter, not a kernel one).
#
eeprom_readable() {
	for eeprom in "$SYS_I2C"/*/eeprom; do
		[ -e "$eeprom" ] || continue
		got=$(dd if="$eeprom" bs=1 count=16 2>/dev/null | wc -c)
		if [ "${got:-0}" -gt 0 ]; then
			log "EEPROM readable: $got bytes from $eeprom"
			return 0
		fi
		log "FAILED: EEPROM $eeprom returned no data"
		return 1
	done

	log "FAILED: no EEPROM is exposed under $SYS_I2C"
	return 1
}

#
# rtc_bound
#
# True when the real-time clock the device tree declares at address 0x51 has a
# driver. The PCF8563 driver reads the chip while it probes, so "bound" means
# the I2C transfer worked. A bus read of the time is not used instead: a clock
# that lost its battery refuses to report a time, and that is a hardware state
# that no kernel can fix, so failing it here would refuse every update on such
# a board. A board whose device tree declares no clock at 0x51 skips the check.
#
rtc_bound() {
	found=0
	for rtc in "$SYS_I2C"/*-0051; do
		[ -e "$rtc" ] || continue
		found=1
		if [ ! -e "$rtc/driver" ]; then
			log "FAILED: the RTC at $rtc has no driver"
			return 1
		fi
	done

	if [ "$found" -eq 0 ]; then
		log "no RTC declared at 0x51; RTC check skipped"
	else
		log "RTC driver bound"
	fi
	return 0
}

#
# gateway_reachable
#
# True when the gateway the stager saw answering still answers. Reads
# GATEWAY_NOTE; skipped, with a logged reason, when it names no gateway or
# says the gateway never answered, so an offline board is never blocked.
# Retries for up to GATEWAY_TIMEOUT seconds: the interface, its DHCP lease and
# the switch's forwarding take a while after the kernel is up.
#
gateway_reachable() {
	gw=$(sed -n 's/^GATEWAY=//p' "$GATEWAY_NOTE" 2>/dev/null | head -1 | tr -d '\r')
	answered=$(sed -n 's/^GATEWAY_PING=//p' "$GATEWAY_NOTE" 2>/dev/null | head -1 | tr -d '\r')

	if [ -z "$gw" ] || [ "$answered" != "ok" ]; then
		log "no gateway answered before the update; gateway check skipped"
		return 0
	fi
	case "$gw" in
		*[!0-9.]*)
			log "gateway note names '$gw', not an address; gateway check skipped"
			return 0
			;;
	esac

	gwwaited=0
	while :; do
		if "$PING_BIN" -c 2 -W 2 "$gw" >/dev/null 2>&1; then
			log "gateway $gw answers, after ${gwwaited}s"
			return 0
		fi
		if [ "$gwwaited" -ge "$GATEWAY_TIMEOUT" ]; then
			break
		fi
		sleep "$GATEWAY_INTERVAL"
		gwwaited=$((gwwaited + GATEWAY_INTERVAL))
	done

	log "FAILED: gateway $gw answered before the update and not within ${GATEWAY_TIMEOUT}s of this boot"
	return 1
}

#
# note_version
#
# The version the staged note claims, reduced to a tag. The two writers of
# the note disagree on what VERSION= holds: tpi-selfupdate writes the release
# tag (v2.8.0), the daemon's upload path writes the FILE NAME
# (tp2-bmc-firmware-ota-v2.8.0.tpu). Both reduce to the tag. A build with no
# tag -- "local" -- reduces to a word that is not a version, and the caller
# treats that as "nothing to compare", never as a mismatch.
#
note_version() {
	v=$(sed -n 's/^VERSION=//p' "$STAGED_NOTE" 2>/dev/null | head -1 | tr -d '\r')
	v=${v##*/}
	v=${v%.tpu}
	v=${v#tp2-bmc-firmware-ota-}
	v=${v#tp2-ota-}
	printf '%s' "$v"
}

#
# is_versioned STRING
#
# vMAJOR.MINOR.PATCH and nothing else. The same rule tpi-selfupdate applies.
#
is_versioned() {
	case "$1" in
		v[0-9]*.[0-9]*.[0-9]*) return 0 ;;
	esac
	return 1
}

#
# release_matches
#
# The third gate. The first two prove the image is ALIVE -- the daemon
# answers and the switch probed. This one proves it is the image that was
# staged, and that its daemon serves the endpoint a bad build is most likely
# to have broken. This fork's own /metrics could have shipped completely
# broken and been promoted by the first two checks alone.
#
# Two halves, and each is skipped only for a reason that is logged. A note
# that names no version (a dev build) skips the comparison but still has to
# serve metrics -- a dev image is exactly the one most likely to be wrong.
#
# No credential is fetched any more. /metrics moved to its own plain-HTTP
# listener on 9110 and takes none, so this check is one request. That also
# removed this gate's last dependence on the /api/bmc loopback bypass, which
# it used to need in order to mint a token for itself.
#
release_matches() {
	running=$(sed -n 's/^VERSION=//p' "$OS_RELEASE" 2>/dev/null | tr -d '"' | head -1)
	staged=$(note_version)

	if [ -z "$staged" ]; then
		# A missing note was refused by notes_present, which runs first; this
		# only sees one on a board with no overlay to hold it.
		if [ -f "$STAGED_NOTE" ]; then log "staged note carries no version; version check skipped"
		else log "no staged note; version check skipped"; fi
	elif ! is_versioned "$staged"; then
		log "staged build '$staged' carries no version; version check skipped"
	elif [ "$staged" != "$running" ]; then
		log "FAILED: staged $staged but this image reports $running"
		return 1
	else
		log "version matches the staged note: $running"
	fi

	if [ ! -x "$CURL_BIN" ]; then
		log "no curl; metrics check skipped"
		return 0
	fi

	body=$("$CURL_BIN" -s --max-time 10 "$METRICS_URL" 2>/dev/null) || body=""

	case "$body" in
		*bmcd_build_info*)
			log "metrics answer, with bmcd_build_info"
			return 0
			;;
	esac

	log "FAILED: /metrics did not answer with bmcd_build_info"
	return 1
}

#
# notes_present
#
# The first thing the gate asks: is everything it is about to read there? The
# stagers write the notes before they arm nextboot, so a tentative boot with
# none is an interrupted staging, and judging the image without them would
# skip exactly the checks that need them. Refused, with the reason in the log.
#
# Two things are not refused, both logged: a board with no overlay directory
# (it cannot hold a note, and could not before), and a gateway note that is
# missing under a staged note from a stager that never promised one -- the
# staged note carries GATE_NOTES=1 only when the gateway note was written
# before it.
#
notes_present() {
	notes_dir=$(dirname "$STAGED_NOTE")
	if [ ! -d "$notes_dir" ]; then
		log "no $notes_dir; the staged notes cannot exist, so the note check is skipped"
		return 0
	fi

	if [ ! -f "$STAGED_NOTE" ]; then
		log "FAILED: no staged note on a tentative boot; staging did not finish before the reboot"
		return 1
	fi

	if grep -qx 'GATE_NOTES=1' "$STAGED_NOTE" 2>/dev/null && [ ! -f "$GATEWAY_NOTE" ]; then
		log "FAILED: the staged note says the gateway note was written first, and there is none"
		return 1
	fi

	return 0
}

#
# health_ok
#
# The gate. Waits for the daemon, checks the switch and its uplinks, the EEPROM
# and the RTC, then checks that this is the release that was staged, that it
# serves metrics, and that a gateway which answered before still answers.
#
health_ok() {
	if ! notes_present; then
		return 1
	fi

	waited=0
	answered=0

	while [ "$waited" -lt "$HEALTH_TIMEOUT" ]; do
		if bmcd_answers; then
			answered=1
			break
		fi
		sleep "$HEALTH_INTERVAL"
		waited=$((waited + HEALTH_INTERVAL))
	done

	if [ "$answered" -ne 1 ]; then
		log "FAILED: bmcd did not answer within ${HEALTH_TIMEOUT}s"
		return 1
	fi
	log "bmcd answered after ${waited}s"

	if ! switch_ports_present; then
		return 1
	fi
	log "switch ports present: $SWITCH_PORTS"

	if ! uplinks_present; then
		return 1
	fi
	log "uplink ports present: $UPLINK_PORTS"

	if ! eeprom_readable; then
		return 1
	fi

	if ! rtc_bound; then
		return 1
	fi

	if ! release_matches; then
		return 1
	fi

	if ! gateway_reachable; then
		return 1
	fi

	return 0
}

#
# rollback
#
# Undo nothing and reboot; see the note at the top of this file.
#
# The staged note has served its purpose the moment this script decides.
# Never fatal: a board that cannot remove it is still a board that just
# promoted or rejected an image, and that outcome matters more.
clear_staged_note() {
	rm -f "$STAGED_NOTE" "$GATEWAY_NOTE" 2>/dev/null || true
}

rollback() {
	log "rolling back to the volume named $ROOTFS_PRIMARY by rebooting"
	# Drop it before the reboot: the image it names is the one being rejected.
	clear_staged_note
	sync
	reboot
	# reboot(8) returns as soon as it has signalled init. Block here so that
	# the caller cannot fall through and promote the image we just rejected.
	sleep "$HEALTH_TIMEOUT"
}

#
# ubi_block_name
#
# Echoes the name of the volume currently attached as a UBI block device
#
ubi_block_name() {
	for block in /sys/class/block/ubiblock*; do
		blockdev=$(basename $block)
		namepath=/sys/class/ubi/${blockdev//block/}/name
		if [ -f $namepath ]; then
			cat "$namepath"
			return 0
		fi
	done

	return 1
}

#
# ubi_exists NAME
#
# Checks for the existence of the named UBI volume
#
ubi_exists() {
	NAME=$1

	for entry in /sys/class/ubi/$(basename "$UBIDEV")/ubi*; do
		if [ ! -f $entry/name ]; then continue; fi
		if grep -Fxq "$NAME" $entry/name >/dev/null; then
			return 0
		fi
	done

	return 1
}

postupdate() {
	# Is the rename even necessary?
	root_name=$(ubi_block_name)
	if [ "x$root_name" = "x$ROOTFS_PRIMARY" ]; then
		return;
	fi

	# The rename is necessary; $root_name -> $ROOTFS_PRIMARY
	renames="$root_name $ROOTFS_PRIMARY"
	if ubi_exists "$ROOTFS_PRIMARY"; then
		# First move $ROOTFS_PRIMARY to $ROOTFS_SECONDARY.
		# This clobbers the latter if it exists.
		renames="$ROOTFS_PRIMARY $ROOTFS_SECONDARY $renames"
	fi
	ubirename "$UBIDEV" $renames
	echo "postupdate: Volumes renamed: $renames"

	# Carry forward what this image replaced, before the note is removed.
	#
	# The rollback volume is not mounted, so nothing on a running board can
	# read its version -- which is why the interface could only say "version
	# not readable". The stager knew it and wrote REPLACES=; this is the one
	# moment it is still on disk and the rename has just made it true.
	# Never fatal: a board that cannot record this has still promoted.
	replaces=$(sed -n 's/^REPLACES=//p' "$STAGED_NOTE" 2>/dev/null | head -1 | tr -d '\r')
	if [ -n "$replaces" ]; then
		printf '%s\n' "$replaces" > "$ROLLBACK_VERSION" 2>/dev/null \
			|| log "could not record the rollback version"
	fi

	# Promoted: what the note describes is now what is running.
	clear_staged_note
}

#
# drop_stale_notes
#
# The notes in /mnt/overlay describe UBI volumes, and the overlay can outlive
# them: the SD-card installer deletes rootfs_new and rootfs_prev but keeps the
# overlay. A note whose volume is gone would name a version that does not
# exist (bmcd reports the staged note without checking for the volume).
# Runs on every boot, before the postupdate check below; never fatal.
#
drop_stale_notes() {
	if ! ubi_exists rootfs_new; then
		rm -f "$STAGED_NOTE" "$GATEWAY_NOTE" 2>/dev/null || true
	fi
	if ! ubi_exists "$ROOTFS_SECONDARY"; then
		rm -f "$ROLLBACK_VERSION" 2>/dev/null || true
	fi
}

#
# nextboot_state
#
# armed, unset or unknown. `fw_printenv -n` exits non-zero both for a variable
# that is not set and for an environment it cannot read; only the first says
# "not defined". Unknown is never treated as unset: the caller then keeps
# what it has.
#
nextboot_state() {
	out=$("$FW_PRINTENV_BIN" -n nextboot 2>&1) && rc=0 || rc=$?
	if [ "$rc" -eq 0 ]; then
		if [ -n "$out" ]; then echo armed; else echo unset; fi
		return 0
	fi
	case "$out" in
		*"not defined"*) echo unset ;;
		*) echo unknown ;;
	esac
}

#
# drop_unarmed_notes
#
# A boot that is not tentative, with nextboot unset: whatever staged notes
# there are describe an update that is not going to boot. Either the staging
# was cut before it armed nextboot, or the tentative boot was cut before the
# gate decided (U-Boot has already deleted nextboot by then) and the board came
# back on the old image. Either way the firmware page would show a staged
# version for ever. Remove the notes and say so.
#
# Left alone when a stager holds the staging lock: it has written its notes
# and not armed nextboot yet, and is about to. If the notes went, the update
# would still arm and then fail its gate for a missing note, safe but
# pointless. Left alone too when nextboot cannot be read.
#
# Never fatal.
#
drop_unarmed_notes() {
	if [ ! -e "$STAGED_NOTE" ] && [ ! -e "$GATEWAY_NOTE" ]; then
		return 0
	fi
	if [ "$(nextboot_state)" != unset ]; then
		return 0
	fi

	staged=$(note_version)
	had_staged=0
	if [ -e "$STAGED_NOTE" ]; then had_staged=1; fi

	if [ -w "$(dirname "$STAGE_LOCK")" ] && command -v flock >/dev/null 2>&1; then
		if ! (
			exec 9>"$STAGE_LOCK" && flock -n 9 \
				&& rm -f "$STAGED_NOTE" "$STAGED_NOTE.new" "$GATEWAY_NOTE" "$GATEWAY_NOTE.new"
		) 2>/dev/null; then
			log "a stager holds the staging lock; its notes are left in place"
			return 0
		fi
	else
		rm -f "$STAGED_NOTE" "$STAGED_NOTE.new" "$GATEWAY_NOTE" "$GATEWAY_NOTE.new" 2>/dev/null || true
	fi

	if [ "$had_staged" -eq 1 ]; then
		log "tentative boot did not complete; staged ${staged:-update} discarded (nextboot is not armed)"
	else
		log "staging did not finish; the stale gateway note is discarded (nextboot is not armed)"
	fi
}

start() {
	drop_stale_notes

	if ! grep -q 'postupdate' "$PROC_CMDLINE"; then
		drop_unarmed_notes
		return 0
	fi

	# Nothing to promote: this boot is already on the primary volume.
	if [ "$(ubi_block_name)" = "$ROOTFS_PRIMARY" ]; then
		drop_unarmed_notes
		return 0
	fi

	log "tentative boot; checking this image before making it permanent"
	if health_ok; then
		postupdate
		return 0
	fi

	# With no primary volume there is nothing for u-boot to fall back to, so
	# rebooting would leave the board with no image at all. A broken image we
	# can still reach beats none.
	if ! ubi_exists "$ROOTFS_PRIMARY"; then
		log "no $ROOTFS_PRIMARY volume to fall back to; promoting anyway"
		postupdate
		return 0
	fi

	rollback
}

case "$1" in
	start)
		start;;
	force)
		postupdate;;
esac
