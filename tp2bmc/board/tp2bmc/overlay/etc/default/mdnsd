# Bind mdnsd to exactly one interface, and to nothing else.
#
# Left to itself it binds every interface it can see. On this board that means
# the DSA switch ports -- node1..node4, ge0, dsa -- which all share one MAC and
# one link-local address, because they are ports of a single switch rather than
# separate hosts. mdnsd announces on each, sees its own announcement arrive on
# the others, and calls that a name conflict.
#
# The result is a reload storm: 825 config reloads in twelve seconds, measured
# on 2026-09-09. Each reload leaks (SQU-175), which is what consumed the board
# twice that day, and the log spam lands in /var/log on a 58 MB tmpfs.
#
# So the rule is one interface, never zero and never several. Which one is
# decided here, at the moment this file is sourced, because the stock layout
# has a bridge called br0 but a hand-split network may not (br-wan and br-lan,
# say). Binding a name that does not exist leaves mdnsd announcing nowhere.
# In order:
#
#   1. br0, when it exists. This is the stock layout and the common case.
#   2. the interface holding the IPv4 default route, but only if it is a
#      bridge (it has a bridge/ directory in sysfs). A default route can also
#      sit on a switch port (node1..node4, ge0, ge1) or the dsa conduit, and
#      those are exactly the interfaces the storm comes from.
#   3. the first bridge. This covers a default route that is not up yet (DHCP
#      still pending when S50mdnsd runs) or that is not on a bridge.
#   4. the default-route interface itself, if it exists and is not dsa: a
#      single plain interface, e.g. ge0 configured directly with no bridge.
#   5. br0 anyway, which is what this file always said before.
#
# This file is sourced as shell by /etc/init.d/S50mdnsd on every invocation --
# start, stop, restart -- so it must stay quick and must never wait. The choice
# is made once per start. If the default route comes up later and the answer
# changes, /usr/sbin/mdnsd-guard (run from cron every five minutes) notices
# that the running mdnsd is on a different interface than this file now picks
# and restarts it. A running mdnsd is never moved any other way.

# Prefixed names: this file is sourced into S50mdnsd's own namespace, and the
# init script's variables (DAEMON, MDNSD, PIDFILE, status, ...) must not be
# overwritten by a helper.
mdnsd_pick_iface() {
	mdnsd_net=/sys/class/net

	# 1. the stock bridge
	if [ -e "$mdnsd_net/br0" ]; then
		echo br0
		return 0
	fi

	# The IPv4 default-route interface(s), first one first. Globbing is off
	# for the unquoted expansion: device names are data, not patterns.
	set -f
	mdnsd_defs=$(ip -4 route show 2>/dev/null | awk '
		$1 == "default" {
			for (i = 2; i < NF; i++)
				if ($i == "dev") { print $(i + 1); break }
		}')

	# 2. the default-route interface, if it is a bridge
	for mdnsd_dev in $mdnsd_defs; do
		if [ -d "$mdnsd_net/$mdnsd_dev/bridge" ]; then
			set +f
			echo "$mdnsd_dev"
			return 0
		fi
	done
	set +f

	# 3. the first bridge
	for mdnsd_dir in "$mdnsd_net"/*; do
		if [ -d "$mdnsd_dir/bridge" ]; then
			echo "${mdnsd_dir##*/}"
			return 0
		fi
	done

	# 4. a single non-bridge default-route interface, never the DSA conduit
	set -f
	for mdnsd_dev in $mdnsd_defs; do
		if [ "$mdnsd_dev" != dsa ] && [ -e "$mdnsd_net/$mdnsd_dev" ]; then
			set +f
			echo "$mdnsd_dev"
			return 0
		fi
	done
	set +f

	# 5. today's behaviour
	echo br0
}

MDNSD_IFACE=$(mdnsd_pick_iface)
# shellcheck disable=SC2034 # read by /etc/init.d/S50mdnsd, which sources this
MDNSD_ARGS="-i ${MDNSD_IFACE:-br0}"
