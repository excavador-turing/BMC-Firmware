+static int rtl8365mb_port_vlan_del(struct dsa_switch *ds, int port,
+                                   const struct switchdev_obj_port_vlan *vlan)
+{
+        struct realtek_priv *priv = ds->priv;
+        struct rtl8365mb *mb = (struct rtl8365mb *)priv->chip_data;
+        bool deleting_pvid = mb->pvid_vid[port] == vlan->vid;
+        struct rtl8365mb_vlan4k vlan4k;
+        struct rtl8365mb_vlan_mc vlanmc;
+        u8 pvid_index;
+        u8 mc_index;
+        int ret;
+
+        if (vlan->vid > RTL8365MB_VLAN_MAX)
+                return -EINVAL;
+
+        if (deleting_pvid) {
+                enum rtl8365mb_frame_ingress frame_type;
+
+                frame_type = (mb->vlan_filtering_ports & BIT(port)) ?
+                        RTL8365MB_FRAME_TYPE_TAGGED_ONLY :
+                        RTL8365MB_FRAME_TYPE_ANY_FRAME;
+
+                ret = rtl8365mb_port_set_framefilter(priv, port, frame_type);
+                if (ret)
+                        return ret;
+
+                ret = rtl8365mb_port_pvid_set(priv, port, 0);
+                if (ret)
+                        return ret;
+
+                mb->pvid_vid[port] = 0;
+
+        }
+
+        ret = rtl8365mb_vlan4k_read(priv, vlan->vid, &vlan4k);
+        if (ret)
+                return ret;
+
+        vlan4k.member &= ~BIT(port);
+        vlan4k.untag &= ~BIT(port);
+
+        /*
+         * Keep the CPU port while at least one user port remains in
+         * the VLAN. When the last user port leaves, clear the CPU
+         * membership too so the VLAN/MC entry can become empty.
+         */
+        if ((vlan4k.member & ~mb->cpu.mask) == 0)
+                vlan4k.member = 0;
+
+        ret = rtl8365mb_vlan4k_write(priv, &vlan4k);
+        if (ret)
+                return ret;
+
+        ret = rtl8365mb_vlan_mc_find(priv, vlan->vid, &mc_index);
+        if (ret == -ENOENT)
+                return 0;
+        if (ret)
+                return ret;
+
+        ret = rtl8365mb_vlan_mc_read(priv, mc_index, &vlanmc);
+        if (ret)
+                return ret;
+
+        vlanmc.member = vlan4k.member;
+
+        if (vlanmc.member == 0) {
+                /*
+                 * Do not leave a port pointing at an MC entry that is about
+                 * to be cleared.
+                 */
+                ret = rtl8365mb_port_pvid_get(priv, port, &pvid_index);
+                if (ret)
+                        return ret;
+
+                if (pvid_index == mc_index) {
+                        /*
+                         * Index 0 is the hardware's default VLAN member
+                         * configuration after reset. Move the port away
+                         * from the deleted entry before clearing it.
+                         */
+                        if (mc_index != 0) {
+                                ret = rtl8365mb_port_pvid_set(priv, port, 0);
+                                if (ret)
+                                        return ret;
+                        }
+                }
+
+                memset(&vlanmc, 0, sizeof(vlanmc));
+        } else {
+                vlanmc.evid = vlan->vid;
+                vlanmc.fid = vlan4k.fid;
+                vlanmc.priority = vlan4k.priority;
+                vlanmc.priority_en = vlan4k.priority_en;
+                vlanmc.policing_en = vlan4k.policing_en;
+                vlanmc.meter = vlan4k.meter;
+        }
+
+        ret = rtl8365mb_vlan_mc_write(priv, mc_index, &vlanmc);
+        if (ret)
+                return ret;
+
+        dev_dbg(priv->dev,
+                "port %d: deleted VLAN %u\n",
+                port, vlan->vid);
+
+        return 0;
+}
+
+
+static int rtl8365mb_port_vlan_add(struct dsa_switch *ds, int port,
+                                   const struct switchdev_obj_port_vlan *vlan,
+                                   struct netlink_ext_ack *extack)
+{
+        struct realtek_priv *priv = ds->priv;
+        struct rtl8365mb *mb = (struct rtl8365mb *)priv->chip_data;
+        struct rtl8365mb_vlan4k vlan4k;
+        struct rtl8365mb_vlan_mc vlanmc;
+        u8 mc_index;
+        int ret;
+
+        if (vlan->vid > RTL8365MB_VLAN_MAX)
+                return -EINVAL;
+
+        ret = rtl8365mb_vlan4k_read(priv, vlan->vid, &vlan4k);
+        if (ret)
+                return ret;
+
+        /*
+         * The CPU port must be a member of every hardware VLAN used by
+         * a user port, otherwise switch-to-CPU traffic is filtered out.
+         */
+        vlan4k.member |= BIT(port) | mb->cpu.mask;
+
+        if (vlan->flags & BRIDGE_VLAN_INFO_UNTAGGED)
+                vlan4k.untag |= BIT(port);
+        else
+                vlan4k.untag &= ~BIT(port);
+
+        vlan4k.ivl = true;
+
+        ret = rtl8365mb_vlan4k_write(priv, &vlan4k);
+        if (ret)
+                return ret;
+
+        /*
+         * If an MC entry for this VLAN already exists, keep it in sync
+         * with the 4K VLAN table.
+         */
+        ret = rtl8365mb_vlan_mc_obtain(priv, vlan->vid, &mc_index);
+        if (ret)
+                return ret;
+
+        ret = rtl8365mb_vlan_mc_read(priv, mc_index, &vlanmc);
+        if (ret)
+                return ret;
+
+        vlanmc.evid = vlan->vid;
+        vlanmc.member = vlan4k.member;
+        vlanmc.fid = vlan4k.fid;
+        vlanmc.priority = vlan4k.priority;
+        vlanmc.priority_en = vlan4k.priority_en;
+        vlanmc.policing_en = vlan4k.policing_en;
+        vlanmc.meter = vlan4k.meter;
+
+        ret = rtl8365mb_vlan_mc_write(priv, mc_index, &vlanmc);
+        if (ret)
+                return ret;
+
+        if (vlan->flags & BRIDGE_VLAN_INFO_PVID) {
+                ret = rtl8365mb_port_pvid_set(priv, port, mc_index);
+                if (ret)
+                        return ret;
+
+                ret = rtl8365mb_port_set_framefilter(
+                        priv, port, RTL8365MB_FRAME_TYPE_ANY_FRAME);
+                if (ret)
+                        return ret;
+
+                mb->pvid_vid[port] = vlan->vid;
+
+        }
+
+        dev_dbg(priv->dev,
+                "port %d: added VLAN %u%s%s\n",
+                port, vlan->vid,
+                vlan->flags & BRIDGE_VLAN_INFO_PVID ? " pvid" : "",
+                vlan->flags & BRIDGE_VLAN_INFO_UNTAGGED ? " untagged" : "");
+
+        return 0;
+}
+
+static int rtl8365mb_port_set_transparent(struct realtek_priv *priv,
+                                           int ingress_port,
+                                           int egress_port,
+                                           bool enable)
+{
+        return regmap_update_bits(
+                priv->map,
+                RTL8365MB_VLAN_EGRESS_TRANSPARENT_REG(egress_port),
+                BIT(ingress_port),
+                enable ? BIT(ingress_port) : 0);
+}
+
+static int rtl8365mb_port_set_vlan_egress_mode(struct realtek_priv *priv,
+                                                int port,
+                                                u16 mode)
+{
+        u16 val = mode << 4;
+
+        return regmap_update_bits(priv->map,
+                                  RTL8365MB_PORT_MISC_CFG_REG(port),
+                                  RTL8365MB_VLAN_EGRESS_MODE_MASK,
+                                  val);
+}
+
+
+static int rtl8365mb_port_vlan_filtering(struct dsa_switch *ds, int port,
+                                         bool vlan_filtering,
+                                         struct netlink_ext_ack *extack)
+{
+        struct realtek_priv *priv = ds->priv;
+        struct rtl8365mb *mb = (struct rtl8365mb *)priv->chip_data;
+        enum rtl8365mb_frame_ingress accepted_frame;
+        enum rtl8365mb_frame_ingress prev_accepted_frame;
+        struct dsa_port *dp;
+        u16 configured_ports = 0;
+        u16 mode;
+        int ret;
+
+        ret = rtl8365mb_port_get_framefilter(priv, port,
+                                             &prev_accepted_frame);
+        if (ret)
+                return ret;
+
+        /*
+         * While VLAN filtering is active, a port without a Linux PVID
+         * must only accept tagged frames. A port with a PVID accepts
+         * both tagged and untagged traffic; untagged traffic is then
+         * classified into that PVID by the switch.
+         */
+        if (vlan_filtering && !mb->pvid_vid[port])
+                accepted_frame = RTL8365MB_FRAME_TYPE_TAGGED_ONLY;
+        else
+                accepted_frame = RTL8365MB_FRAME_TYPE_ANY_FRAME;
+
+        ret = regmap_update_bits(priv->map,
+                                 RTL8365MB_VLAN_INGRESS_REG,
+                                 BIT(port),
+                                 vlan_filtering ? BIT(port) : 0);
+        if (ret)
+                return ret;
+
+        dsa_switch_for_each_available_port(dp, ds) {
+                ret = rtl8365mb_port_set_transparent(priv,
+                                                      port,
+                                                      dp->index,
+                                                      !vlan_filtering);
+                if (ret)
+                        goto rollback_transparent;
+
+                configured_ports |= BIT(dp->index);
+        }
+
+        if (accepted_frame != prev_accepted_frame) {
+                ret = rtl8365mb_port_set_framefilter(priv, port,
+                                                     accepted_frame);
+                if (ret)
+                        goto rollback_transparent;
+        }
+
+        mode = vlan_filtering ?
+                RTL8365MB_VLAN_EGRESS_ORIGINAL :
+                RTL8365MB_VLAN_EGRESS_REAL_KEEP;
+
+        ret = rtl8365mb_port_set_vlan_egress_mode(priv, port, mode);
+        if (ret)
+                goto rollback_framefilter;
+
+        if (vlan_filtering)
+                mb->vlan_filtering_ports |= BIT(port);
+        else
+                mb->vlan_filtering_ports &= ~BIT(port);
+
+        return 0;
+
+rollback_framefilter:
+        if (accepted_frame != prev_accepted_frame)
+                rtl8365mb_port_set_framefilter(priv, port,
+                                               prev_accepted_frame);
+
+rollback_transparent:
+        dsa_switch_for_each_port(dp, ds) {
+                if (!(configured_ports & BIT(dp->index)))
+                        continue;
+
+                rtl8365mb_port_set_transparent(priv,
+                                               port,
+                                               dp->index,
+                                               vlan_filtering);
+        }
+
+        regmap_update_bits(priv->map,
+                           RTL8365MB_VLAN_INGRESS_REG,
+                           BIT(port),
+                           vlan_filtering ? 0 : BIT(port));
+
+        return ret;
+}
