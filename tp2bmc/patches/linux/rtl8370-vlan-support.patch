+static int rtl8365mb_vlan_setup(struct dsa_switch *ds)
+{
+        struct realtek_priv *priv = ds->priv;
+        struct dsa_port *dp;
+        int ret;
+
+        dsa_switch_for_each_available_port(dp, ds) {
+                ret = rtl8365mb_port_vlan_filtering(ds, dp->index,
+                                                    false, NULL);
+                if (ret) {
+                        dev_err(priv->dev,
+                                "failed to disable VLAN filtering on port %d: %d\n",
+                                dp->index, ret);
+                        return ret;
+                }
+        }
+
+        ret = regmap_update_bits(priv->map,
+                                 RTL8365MB_VLAN_CTRL_REG,
+                                 RTL8365MB_VLAN_CTRL_ENABLE,
+                                 RTL8365MB_VLAN_CTRL_ENABLE);
+        if (ret)
+                return ret;
+
+        dev_dbg(priv->dev, "global VLAN engine enabled\n");
+
+        return 0;
+}
