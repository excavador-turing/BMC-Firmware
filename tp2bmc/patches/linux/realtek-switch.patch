diff --git a/drivers/net/dsa/realtek/realtek-i2c.c b/drivers/net/dsa/realtek/realtek-i2c.c
new file mode 100644
--- a/drivers/net/dsa/realtek/realtek-i2c.c
+++ b/drivers/net/dsa/realtek/realtek-i2c.c
@@ -0,0 +1,196 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Realtek switch driver for chips wired to a real I2C bus.
+ *
+ * Realtek's "SMI" is a bit-banged protocol that is close enough to I2C for
+ * the RTL8365MB/RTL8366RB family to be wired straight onto an I2C
+ * controller instead, which is what the Turing Pi 2 does: the switch is an
+ * I2C client at 0x5c on the SoC's i2c2.
+ *
+ * The chip does not speak plain I2C for reads. A conventional I2C read is a
+ * write transfer naming the register, a repeated START, then a read
+ * transfer. In "RTK" mode the register is instead pushed into the middle of
+ * a single read transfer -- two extra bytes after the address byte, with no
+ * START between them -- and only then does the bus turn around. That is
+ * expressible with I2C_M_NOSTART, so this driver requires an adapter with
+ * I2C_FUNC_NOSTART and refuses to bind without it.
+ *
+ * Writes need no such trick and are ordinary I2C writes.
+ */
+
+#include <linux/module.h>
+#include <linux/i2c.h>
+#include <linux/regmap.h>
+
+#include "realtek.h"
+#include "realtek-i2c.h"
+#include "rtl83xx.h"
+
+static int realtek_i2c_read(void *ctx, const void *reg, size_t reg_size,
+			    void *val, size_t val_size)
+{
+	struct device *dev = ctx;
+	struct i2c_client *i2c = to_i2c_client(dev);
+	int ret;
+
+	struct i2c_msg xfer[] = {
+		/* Start the transfer and send only the address byte. */
+		{
+			.addr = i2c->addr,
+			.flags = I2C_M_RD,
+			.len = 0,
+		},
+		/* Push the register bytes in without a START. */
+		{
+			.addr = i2c->addr,
+			.flags = I2C_M_NOSTART,
+			.len = reg_size,
+			.buf = (void *)reg,
+		},
+		/* Turn the bus around and read the value. */
+		{
+			.addr = i2c->addr,
+			.flags = I2C_M_RD | I2C_M_NOSTART,
+			.len = val_size,
+			.buf = val,
+		},
+	};
+
+	ret = i2c_transfer(i2c->adapter, xfer, ARRAY_SIZE(xfer));
+	if (ret == ARRAY_SIZE(xfer))
+		return 0;
+	if (ret < 0)
+		return ret;
+
+	return -EIO;
+}
+
+static int realtek_i2c_write(void *ctx, const void *data, size_t count)
+{
+	struct device *dev = ctx;
+	struct i2c_client *i2c = to_i2c_client(dev);
+	int ret;
+
+	ret = i2c_master_send(i2c, data, count);
+	if (ret == count)
+		return 0;
+	if (ret < 0)
+		return ret;
+
+	return -EIO;
+}
+
+static const struct regmap_config realtek_i2c_regmap_config = {
+	.reg_bits = 16,
+	.val_bits = 16,
+	.reg_format_endian = REGMAP_ENDIAN_LITTLE,
+	.val_format_endian = REGMAP_ENDIAN_LITTLE,
+	.read = realtek_i2c_read,
+	.write = realtek_i2c_write,
+	.cache_type = REGCACHE_NONE,
+	.lock = rtl83xx_lock,
+	.unlock = rtl83xx_unlock,
+};
+
+static int realtek_i2c_setup_regmaps(struct realtek_priv *priv)
+{
+	struct i2c_client *client = to_i2c_client(priv->dev);
+	struct regmap_config rc;
+
+	rc = realtek_i2c_regmap_config;
+	rc.lock_arg = priv;
+
+	priv->map = devm_regmap_init_i2c(client, &rc);
+	if (IS_ERR(priv->map))
+		return PTR_ERR(priv->map);
+
+	rc.disable_locking = true;
+	priv->map_nolock = devm_regmap_init_i2c(client, &rc);
+	if (IS_ERR(priv->map_nolock))
+		return PTR_ERR(priv->map_nolock);
+
+	return 0;
+}
+
+static const struct realtek_interface_info realtek_i2c_info = {
+	.setup_regmaps = realtek_i2c_setup_regmaps,
+};
+
+/**
+ * realtek_i2c_probe() - Probe an I2C-connected Realtek switch
+ * @client: i2c_client to probe on.
+ *
+ * Context: Can sleep.
+ * Return: 0 on success, a negative error on failure.
+ */
+int realtek_i2c_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct realtek_priv *priv;
+	int ret;
+
+	/* "RTK" mode reads are a single transfer with the register spliced
+	 * into the middle of it, so the adapter has to be able to suppress
+	 * the repeated START.
+	 */
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_NOSTART))
+		return dev_err_probe(dev, -ENODEV,
+				     "'rtk' mode needs an adapter with NOSTART support\n");
+
+	priv = rtl83xx_probe(dev, &realtek_i2c_info);
+	if (IS_ERR(priv))
+		return PTR_ERR(priv);
+
+	/* There is no write-without-ack on I2C: the chip stops acking the
+	 * moment a soft reset lands, and the adapter reports that as an
+	 * error rather than as a protocol step we can ask for. Leave
+	 * priv->write_reg_noack NULL; the subdrivers fall back to a plain
+	 * regmap_write for the reset register.
+	 */
+
+	ret = rtl83xx_register_switch(priv);
+	if (ret) {
+		rtl83xx_remove(priv);
+		return ret;
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL_NS_GPL(realtek_i2c_probe, REALTEK_DSA);
+
+/**
+ * realtek_i2c_remove() - Remove an I2C-connected Realtek switch
+ * @client: i2c_client being removed.
+ *
+ * Context: Can sleep.
+ * Return: Nothing.
+ */
+void realtek_i2c_remove(struct i2c_client *client)
+{
+	struct realtek_priv *priv = i2c_get_clientdata(client);
+
+	if (!priv)
+		return;
+
+	rtl83xx_unregister_switch(priv);
+
+	rtl83xx_remove(priv);
+}
+EXPORT_SYMBOL_NS_GPL(realtek_i2c_remove, REALTEK_DSA);
+
+/**
+ * realtek_i2c_shutdown() - Shut down an I2C-connected Realtek switch
+ * @client: i2c_client shutting down.
+ *
+ * Context: Can sleep.
+ * Return: Nothing.
+ */
+void realtek_i2c_shutdown(struct i2c_client *client)
+{
+	struct realtek_priv *priv = i2c_get_clientdata(client);
+
+	if (!priv)
+		return;
+
+	rtl83xx_shutdown(priv);
+}
+EXPORT_SYMBOL_NS_GPL(realtek_i2c_shutdown, REALTEK_DSA);
