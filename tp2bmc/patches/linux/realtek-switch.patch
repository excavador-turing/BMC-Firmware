From 98700d5b9f4bc8803003d828b6e9da2dbb6c3ca0 Mon Sep 17 00:00:00 2001
From: Sam Edwards <CFSworks@gmail.com>
Date: Wed, 28 Feb 2024 15:34:56 -0700
Subject: [PATCH] local: hack in RTL8370MB-CG to dsa driver

local: realtek: cmd_{read,write} -> i2c_addr

local: realtek: clean up `chip_data`

local: realtek: simplify/clean up regmap config

local: realtek: kill off `realtek_smi_write_reg_noack`

local: realtek: become an i2c driver, not platform

local: realtek: Implement "Realtek"/"RTK" I2C mode

local: realtek: add back GPIO support

local: begin improving tagging decoder

local: realtek: trap standalone ports rather than use the isolation matrix

local: realtek: implement bridge offload

Rebased onto Linux 6.12.104, and this one is a port rather than a rebase.

Re-verified against 6.12.109, where it still applies unchanged at fuzz 0.
That range does touch rtl83xx.c -- the one file this patch shares with
upstream -- but at the other end of it: 6.12.109 takes "net: dsa: realtek:
use gpiod_set_value_cansleep for reset GPIO", which rewrites two lines in
rtl83xx_reset_{assert,deassert}() around line 309, while the single hunk
here is the setup_regmaps() hook in rtl83xx_probe() around line 156. Both
survive.

Between 6.8 and 6.12 the realtek DSA driver was restructured upstream
(Luiz Angelo Daros de Luca): the probe/regmap/registration code that
lived in realtek-smi.c and realtek-mdio.c moved into a new common
rtl83xx.c, realtek_priv gained an EMBEDDED struct dsa_switch instead of a
pointer, clk_delay/cmd_read/cmd_write moved from realtek_priv into
realtek_variant, ds_ops_smi and ds_ops_mdio merged into one ds_ops with a
separate phylink_mac_ops, and each subdriver now owns its own
platform_driver and mdio_driver. Every hunk against realtek-smi.c,
realtek-mdio.c, realtek.h and the Kconfig failed; rtl8365mb.c partly
failed.

The 6.8 patch had turned realtek-smi.c wholesale into an i2c_driver.
Doing that again would mean deleting upstream's SMI driver, so instead
I2C is added ALONGSIDE SMI and MDIO, which is the shape 6.12 already has:

* realtek-i2c.c / realtek-i2c.h (new) hold the "RTK" I2C mode -- the
  NOSTART read trick, the 16-bit little-endian regmap, and probe/remove/
  shutdown built on rtl83xx_probe() and rtl83xx_register_switch(). The
  bit-banged i2c-gpio adapter from the 6.8 version is NOT carried over:
  on this board the switch hangs off the SoC's i2c2 as a plain I2C client
  at 0x5c, so that path never bound to anything here.
* rtl83xx: realtek_interface_info gains an optional setup_regmaps() hook.
  rtl83xx_probe() builds a reg_read/reg_write regmap for the register-
  level interfaces (SMI, MDIO); I2C is a bus-level interface and needs
  devm_regmap_init_i2c(), so it supplies its own. This is the only change
  to shared code, and SMI and MDIO take the unchanged path.
* NET_DSA_REALTEK_I2C is a new Kconfig symbol selecting REGMAP_I2C. The
  6.8 patch instead added `select I2C_GPIO` and `select REGMAP_I2C` to
  NET_DSA_REALTEK_SMI; I2C_GPIO went with the bit-banged adapter.
* rtl8365mb.c and rtl8366rb.c register an i2c_driver next to the existing
  two, and carry .i2c_addr (0x5c / 0x54) in their variant.

Reset needed care. The 6.8 patch deleted write_reg_noack outright,
because SMI was gone. Here SMI and MDIO still use it, and I2C cannot
provide one -- the chip stops acking the moment the reset lands, and an
I2C adapter reports that as an error rather than as a step you can ask
for. So both reset paths now fall back to a plain regmap_write() when the
hook is NULL, leaving SMI and MDIO behaviour bit-for-bit unchanged.

Carried over unchanged from the 6.8 patch: the RTL8370MB-CG chip_info
entry (chip_id 0x6368, ver 0x0010) -- this is the switch actually on the
2.5 board -- the EFID and dot1x register blocks, port_set_trapping(),
port_set_efid(), bridge_apply_isolation(), port_bridge_join/leave, the
setup() change from "isolate to CPU + disable learning" to "clear
isolation + trap on ingress", ds->fdb_isolation and max_num_bridges = 7,
and the tag_rtl8_4.c trap-reason decoding.

Dropped as unnecessary: the `(struct rtl8365mb *)priv->chip_data` casts
that ran through both subdrivers. They existed because the 6.8 patch
changed chip_data to a flexible array member; 6.12 keeps it a void *, so
the casts would be noise.

rtl8365mb_port_set_learning() is left in place and unused, which the
compiler notes. It is equally unused in the 6.8 version of this patch --
the trapping change removed its only caller there too -- so this is not
new, and the function documents a register worth keeping.

---

diff --git a/drivers/net/dsa/realtek/Kconfig b/drivers/net/dsa/realtek/Kconfig
--- a/drivers/net/dsa/realtek/Kconfig
+++ b/drivers/net/dsa/realtek/Kconfig
@@ -29,16 +29,27 @@
 	  Select to enable support for registering switches connected
 	  through SMI.
 
+config NET_DSA_REALTEK_I2C
+	bool "Realtek I2C interface support"
+	depends on OF
+	depends on I2C
+	select REGMAP_I2C
+	help
+	  Select to enable support for registering switches connected
+	  to a real I2C bus and driven in Realtek's "RTK" I2C mode.
+	  Requires an I2C adapter that can do NOSTART transfers.
+
 config NET_DSA_REALTEK_RTL8365MB
 	tristate "Realtek RTL8365MB switch driver"
-	depends on NET_DSA_REALTEK_SMI || NET_DSA_REALTEK_MDIO
+	depends on NET_DSA_REALTEK_SMI || NET_DSA_REALTEK_MDIO || NET_DSA_REALTEK_I2C
 	select NET_DSA_TAG_RTL8_4
 	help
-	  Select to enable support for Realtek RTL8365MB-VC and RTL8367S.
+	  Select to enable support for Realtek RTL8365MB-VC, RTL8367S and
+	  RTL8370MB-CG.
 
 config NET_DSA_REALTEK_RTL8366RB
 	tristate "Realtek RTL8366RB switch driver"
-	depends on NET_DSA_REALTEK_SMI || NET_DSA_REALTEK_MDIO
+	depends on NET_DSA_REALTEK_SMI || NET_DSA_REALTEK_MDIO || NET_DSA_REALTEK_I2C
 	select NET_DSA_TAG_RTL4_A
 	help
 	  Select to enable support for Realtek RTL8366RB.
